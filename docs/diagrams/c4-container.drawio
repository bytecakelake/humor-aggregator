    <mxGraphModel adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="op" value="&lt;b&gt;운영자&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[사람]&lt;/font&gt;&lt;br&gt;&lt;br&gt;규칙·설정을 작성한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="b" value="humor-aggregator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[소프트웨어 시스템]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#444444;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="170" width="320" height="560" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b&gt;규칙·설정 파일&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[파일]&lt;/font&gt;&lt;br&gt;&lt;br&gt;출처, 게시 대상,&lt;br&gt;사이트별 게시 규칙(CEL)을 정의한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="host" value="&lt;b&gt;Host&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[컨테이너: .NET 10 Worker Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;수집 → 중복 제거 → 규칙 평가 → 게시&lt;br&gt;파이프라인을 실행·스케줄링한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="240" height="130" as="geometry"/></mxCell>
