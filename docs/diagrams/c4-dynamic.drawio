<mxCell id="rul" value="&lt;b&gt;RuleEngine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[컴포넌트]&lt;/font&gt;&lt;br&gt;&lt;br&gt;사이트별 게시 규칙과 일일 게시&lt;br&gt;한도를 CEL로 평가한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="290" width="200" height="140" as="geometry"/></mxCell>
