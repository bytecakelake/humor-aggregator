  <diagram name="C4 동적 - 파이프라인 1회 실행" id="c4-dynamic">
    <mxGraphModel adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b" value="Host&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[컨테이너: .NET 10 Worker Service]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#444444;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1070" height="440" as="geometry"/></mxCell>
<mxCell id="orch" value="&lt;b&gt;파이프라인 실행기&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[컴포넌트]&lt;/font&gt;&lt;br&gt;&lt;br&gt;스케줄에 따라 각 단계를 순서대로 호출한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="1010" height="100" as="geometry"/></mxCell>
<mxCell id="col" value="&lt;b&gt;Collectors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[컴포넌트]&lt;/font&gt;&lt;br&gt;&lt;br&gt;출처별 수집기. 출처마다&lt;br&gt;구현체를 추가한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="200" height="140" as="geometry"/></mxCell>
