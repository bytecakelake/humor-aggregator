<mxCell id="op" value="&lt;b&gt;운영자&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[사람]&lt;/font&gt;&lt;br&gt;&lt;br&gt;출처, 게시 대상, 게시 규칙을 설정하고 동작을 확인한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="240" height="120" as="geometry"/></mxCell>
